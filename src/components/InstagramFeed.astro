---
import { site } from '../data/site';
const ig = site.instagram;
---
<section id="feed" data-theme="light" class="relative overflow-hidden bg-bone py-24 sm:py-32" aria-labelledby="feed-title">
  <div class="relative mx-auto w-full max-w-[1440px] px-5 sm:px-10">
    <div class="flex flex-col gap-8 border-b border-espresso pb-8 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="eyebrow text-espresso/50" data-reveal><span class="slash">//</span>MEDIA SHOWCASE</p>
        <h2 id="feed-title" class="mt-4 text-espresso">
          <span class="mask"><span class="display block text-[12vw] leading-[0.9] sm:text-[7vw] lg:text-[4.6rem]">FROM THE FEED</span></span>
        </h2>
      </div>

      <div class="flex items-center gap-4" data-reveal data-delay="0.15">
        <img
          src={ig.profilePic}
          alt={ig.name + ' Instagram profile'}
          loading="lazy"
          referrerpolicy="no-referrer"
          class="h-16 w-16 rounded-full border border-espresso object-cover"
        />
        <div>
          <a href={site.brand.instagram} target="_blank" rel="noopener" class="eyebrow link-underline font-bold text-espresso">@{ig.username}</a>
          <p class="eyebrow mt-1 text-espresso/50">{ig.followers} FOLLOWERS</p>
          <p class="mt-1 text-xs text-espresso/50">{ig.bio}</p>
        </div>
      </div>
    </div>

    <ul class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {ig.posts.map((p, i) => (
        <li data-tilt="6" data-reveal data-delay={0.05 * i}>
          <a
            href={site.brand.instagram}
            target="_blank"
            rel="noopener"
            class="tilt group block border border-espresso bg-white/40"
          >
            <div class="relative aspect-square overflow-hidden">
              <img
                src={p.image}
                alt={p.alt}
                loading="lazy"
                referrerpolicy="no-referrer"
                class="h-full w-full object-cover transition-transform duration-[900ms] group-hover:scale-[1.08]"
              />
              <div class="absolute inset-0 flex items-end bg-espresso/0 p-4 transition-colors duration-500 group-hover:bg-espresso/60">
                <div class="translate-y-3 opacity-0 transition-all duration-500 group-hover:translate-y-0 group-hover:opacity-100">
                  <p class="eyebrow text-white">♥ {p.likes} &nbsp; ✎ {p.comments}</p>
                </div>
              </div>
            </div>
            <div class="flex items-start justify-between gap-3 border-t border-espresso px-4 py-3">
              <p class="line-clamp-2 text-[0.7rem] leading-4 text-espresso/60" dir="auto">{p.caption}</p>
              <span class="eyebrow shrink-0 text-espresso/35">0{i + 1}</span>
            </div>
          </a>
        </li>
      ))}
    </ul>

    <div class="mt-10 flex justify-center" data-reveal>
      <a href={site.brand.instagram} target="_blank" rel="noopener" class="eyebrow link-underline font-bold text-espresso">FOLLOW @{ig.username} →</a>
    </div>
  </div>
</section>