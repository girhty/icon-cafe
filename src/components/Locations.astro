---
import { site } from '../data/site';
const { locations, brand } = site;
const hourMarks = Array.from({ length: 12 }, (_, i) => i + 1);
---
<section id="locations" data-theme="light" class="relative overflow-hidden bg-bone py-24 sm:py-32" aria-labelledby="loc-title">
  <svg class="pointer-events-none absolute -left-28 bottom-0 h-[40rem] w-[40rem] rotate-180 text-oat" viewBox="0 0 400 400" fill="none" aria-hidden="true">
    <path d="M40 300C40 160 140 60 240 100c90 36 60 170-30 170-70 0-100-60-60-110 40-50 130-40 170 20" stroke="currentColor" stroke-width="34" stroke-linecap="round" />
  </svg>

  <div class="relative mx-auto grid w-full max-w-[1440px] gap-14 px-5 sm:px-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
    <!-- Info column -->
    <div>
      <p class="eyebrow flex items-center gap-2 text-espresso/70" data-reveal>
        <span class="h-[7px] w-[7px] rounded-full bg-crema animate-pulseDot"></span>OUR LOCATIONS
      </p>
      <h2 id="loc-title" class="mt-4 text-espresso">
        <span class="mask"><span class="display block text-[12vw] leading-[0.9] sm:text-[7vw] lg:text-[4.6rem]">ONE ROOM.</span></span>
        <span class="mask"><span class="display block text-[12vw] leading-[0.9] sm:text-[7vw] lg:text-[4.6rem]" data-delay="0.1">ALL OF BAGHDAD.</span></span>
      </h2>

      <ul class="mt-12 space-y-8">
        {locations.branches.map((b, i) => (
          <li class="border-t border-espresso/15 pt-5" data-reveal data-delay={0.1 * i}>
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="display text-lg text-espresso sm:text-xl">{b.name}</h3>
              <span class="eyebrow text-espresso/35">{b.code}</span>
            </div>
            <address class="not-italic">
              {b.lines.map((line) => (
                <p class="eyebrow mt-1 text-espresso/50">{line}</p>
              ))}
            </address>
          </li>
        ))}
      </ul>

      <div class="mt-10 flex flex-wrap items-end justify-between gap-6 border-t border-espresso/15 pt-5" data-reveal>
        <div>
          <p class="eyebrow text-espresso/35">OPENING HOURS</p>
          <p class="eyebrow mt-2 text-espresso">{brand.hours[0]}</p>
          <p class="eyebrow tabular-nums text-espresso/60" data-roll={brand.hours[1]}>{brand.hours[1]}</p>
        </div>
        <div class="text-right">
          <p class="eyebrow text-espresso/35">RESERVATIONS & PICKUP</p>
          <a href={brand.phoneHref} class="eyebrow link-underline mt-2 block text-espresso">{brand.phone}</a>
        </div>
      </div>
    </div>

    <!-- Clock dial -->
    <div class="relative" data-tilt="6">
      <div class="tilt relative mx-auto aspect-square w-full max-w-[34rem]" data-parallax="0.08">
        <svg viewBox="0 0 400 400" class="h-full w-full text-espresso" fill="none" aria-hidden="true">
          <circle cx="200" cy="200" r="196" stroke="currentColor" stroke-width="1" />
          <circle cx="200" cy="200" r="168" stroke="currentColor" stroke-opacity="0.35" stroke-width="1" />
          <circle cx="200" cy="200" r="120" stroke="currentColor" stroke-opacity="0.18" stroke-width="1" stroke-dasharray="2 6" />
          {Array.from({ length: 60 }).map((_, i) => (
            <line
              x1="200" y1="14" x2="200" y2={i % 5 === 0 ? 30 : 22}
              stroke="currentColor"
              stroke-opacity={i % 5 === 0 ? '0.8' : '0.25'}
              stroke-width="1"
              transform={`rotate(${i * 6} 200 200)`}
            />
          ))}
          {hourMarks.map((h) => {
            const a = ((h * 30 - 90) * Math.PI) / 180;
            return (
              <text
                x={200 + Math.cos(a) * 146}
                y={200 + Math.sin(a) * 146 + 5}
                text-anchor="middle"
                font-family="Space Mono, monospace"
                font-size="13"
                fill="currentColor"
                fill-opacity="0.6">{String(h).padStart(2, '0')}</text>
            );
          })}
        </svg>

        <div class="absolute inset-0 grid place-items-center">
          <img
            id="dialCup"
            src={locations.centerCup}
            alt="Icon Cafe iced signature drink"
            loading="lazy"
            referrerpolicy="no-referrer"
            class="h-[46%] w-[46%] rounded-full border border-espresso object-cover shadow-glass transition-transform duration-500"
          />
        </div>
      </div>

      <!-- Map card -->
      <div class="mt-8 overflow-hidden border border-espresso" data-reveal>
        <div class="flex items-center justify-between border-b border-espresso px-4 py-3">
          <p class="eyebrow text-espresso"><span class="slash">//</span>MAP / {brand.plusCode}</p>
          <a
            href={`https://www.google.com/maps/search/?api=1&query=${brand.mapQuery}`}
            class="eyebrow link-underline text-espresso"
            rel="noopener"
            target="_blank">OPEN IN MAPS →</a>
        </div>
        <iframe
          title="Map showing Icon Cafe in Al-Jadriyah, Baghdad"
          src={`https://www.google.com/maps?q=${brand.mapQuery}&output=embed`}
          class="h-64 w-full grayscale-[0.6]"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const cup = document.getElementById('dialCup');
    if (!cup) return;
    const sec = document.getElementById('locations');
    function tick() {
      const r = sec.getBoundingClientRect();
      const p = Math.min(Math.max(1 - (r.top + r.height / 2) / window.innerHeight, 0), 1.6);
      cup.style.transform = 'rotate(' + (p * 38).toFixed(2) + 'deg)';
    }
    window.addEventListener('scroll', () => requestAnimationFrame(tick), { passive: true });
    tick();
  })();
</script>