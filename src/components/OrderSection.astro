---
import { site } from '../data/site';
const { order, brand } = site;
---
<section id="order" data-theme="dark" class="relative min-h-[150vh] overflow-hidden bg-espresso" aria-labelledby="order-title">
  <div class="absolute inset-0">
    <img
      src={order.background}
      alt="Cafe counter and table setting at Icon Cafe Baghdad"
      loading="lazy"
      referrerpolicy="no-referrer"
      data-parallax="0.1"
      class="h-full w-full scale-110 object-cover opacity-45 grayscale-[0.35]"
    />
    <div class="absolute inset-0" style="background:linear-gradient(180deg,rgba(7,7,7,0.9),rgba(7,7,7,0.55) 40%,rgba(7,7,7,0.95))"></div>
  </div>

  <div class="relative z-10 mx-auto w-full max-w-[1440px] px-5 py-24 sm:px-10 sm:py-32">
    <div class="grid gap-12 lg:grid-cols-3 lg:items-start">
      <!-- Left copy -->
      <div>
        <p class="eyebrow text-white/50" data-reveal><span class="slash">//</span>ORDER AHEAD</p>
        <h2 id="order-title" class="mt-4 text-white">
          <span class="mask"><span class="display block text-[11vw] leading-[0.92] sm:text-[6vw] lg:text-[3.6rem]">{order.headline}</span></span>
        </h2>
        <p class="eyebrow mt-6 leading-5 text-white/55" data-reveal data-delay="0.15">{order.note}</p>
      </div>

      <!-- Printer + receipt -->
      <div class="relative flex flex-col items-center" id="printerWrap">
        <div class="relative z-20 w-[19rem] max-w-full rounded-[3px] border border-white/15 bg-charcoal/90 px-5 py-4 backdrop-blur">
          <div class="flex items-center justify-between">
            <span class="eyebrow text-white/45">ICON / THERMAL 58MM</span>
            <span class="h-[7px] w-[7px] rounded-full bg-crema animate-pulseDot"></span>
          </div>
          <div class="mt-3 h-2 w-full rounded-sm bg-espresso shadow-[inset_0_2px_6px_rgba(0,0,0,0.9)]"></div>
        </div>

        <div class="relative -mt-1 w-[17.5rem] max-w-full overflow-hidden" style="height:34rem">
          <div id="receipt" class="absolute left-0 top-0 w-full -translate-y-full rotate-[-1.2deg] bg-[#faf8f4] px-5 py-6 shadow-receipt">
            <p class="display text-center text-xl text-espresso">ICON CAFE</p>
            <p class="eyebrow mt-1 text-center text-[0.55rem] text-espresso/50">AL-JADRIYAH • BAGHDAD • IRAQ</p>
            <div class="my-4 border-t border-dashed border-espresso/40"></div>

            <svg viewBox="0 0 60 70" class="mx-auto h-14 w-12 text-espresso" fill="none" aria-hidden="true">
              <path d="M10 18h40l-5 46a4 4 0 0 1-4 4H19a4 4 0 0 1-4-4L10 18Z" stroke="currentColor" stroke-width="2" />
              <rect x="6" y="10" width="48" height="8" rx="2" stroke="currentColor" stroke-width="2" />
              <path d="M50 30c8 0 8 14 0 14" stroke="currentColor" stroke-width="2" />
            </svg>

            <p class="eyebrow mt-4 text-center text-[0.6rem] text-espresso">GOOD COFFEE.</p>
            <p class="eyebrow text-center text-[0.6rem] text-espresso">MADE FOR YOUR DAY.</p>

            <div class="my-4 border-t border-dashed border-espresso/40"></div>
            <p class="eyebrow flex justify-between text-[0.58rem] text-espresso/70"><span>{order.receipt.orderId}</span><span>{order.receipt.time}</span></p>
            <p class="eyebrow flex justify-between text-[0.58rem] text-espresso/70"><span>DATE</span><span>{order.receipt.date}</span></p>
            <p class="eyebrow flex justify-between text-[0.58rem] text-espresso/70"><span>RATING</span><span>★ {brand.rating} / {brand.reviews}</span></p>
            <div class="my-4 border-t border-dashed border-espresso/40"></div>

            <p class="display text-center text-lg leading-tight text-espresso">SKIP THE LINE.<br />ORDER AHEAD.</p>
            <p class="eyebrow mt-2 text-center text-[0.55rem] text-espresso/50">SAVE TIME. GET YOUR COFFEE FASTER.</p>

            <a href={brand.phoneHref} class="mt-4 block bg-espresso py-3 text-center">
              <span class="eyebrow font-bold text-bone">ORDER NOW →</span>
            </a>

            <div class="my-4 border-t border-dashed border-espresso/40"></div>
            <p class="eyebrow text-center text-[0.55rem] text-espresso/50">THANK YOU FOR CHOOSING US.<br />SEE YOU SOON!</p>

            <!-- Barcode -->
            <div id="barcode" class="mt-4 flex h-12 items-end justify-center gap-[2px] opacity-0 transition-opacity duration-700">
              {Array.from({ length: 42 }).map((_, i) => (
                <span class="block bg-espresso" style={`width:${(i % 3) + 1}px;height:${60 + ((i * 17) % 40)}%`}></span>
              ))}
            </div>
            <p class="eyebrow mt-2 text-center text-[0.55rem] tracking-[0.25em] text-espresso/60">{brand.domain}</p>

            <!-- Torn edge -->
            <div class="mt-5 h-3 w-full"
              style="background:linear-gradient(-45deg,transparent 33.3%,#faf8f4 33.3%,#faf8f4 66.6%,transparent 66.6%) 0 0/12px 12px repeat-x;"></div>
          </div>
        </div>
      </div>

      <!-- Right copy -->
      <div class="lg:pt-10">
        <p class="text-sm leading-relaxed text-white/60" data-reveal>{order.aside}</p>
        <div class="mt-8 flex flex-col gap-4" data-reveal data-delay="0.15">
          <a href={brand.phoneHref} class="eyebrow link-underline font-bold text-white">ORDER RIGHT NOW →</a>
          <a href={brand.instagram} target="_blank" rel="noopener" class="eyebrow link-underline text-white/60">DM US ON INSTAGRAM</a>
          <p class="eyebrow text-white/35">DELIVERY VIA TOTERS & TALABAT</p>
        </div>

        <dl class="mt-12 grid grid-cols-2 gap-x-6 gap-y-6 border-t border-white/10 pt-6" data-reveal data-delay="0.25">
          <div>
            <dt class="eyebrow text-white/35">PHONE</dt>
            <dd class="eyebrow mt-1 text-white">{brand.phone}</dd>
          </div>
          <div>
            <dt class="eyebrow text-white/35">HOURS</dt>
            <dd class="eyebrow mt-1 text-white">{brand.hours[1]}</dd>
          </div>
          <div>
            <dt class="eyebrow text-white/35">ADDRESS</dt>
            <dd class="eyebrow mt-1 text-white">{brand.address[0]} / {brand.address[1]}</dd>
          </div>
          <div>
            <dt class="eyebrow text-white/35">PLUS CODE</dt>
            <dd class="eyebrow mt-1 text-white">{brand.plusCode}</dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const sec = document.getElementById('order');
    const receipt = document.getElementById('receipt');
    const barcode = document.getElementById('barcode');
    if (!sec || !receipt) return;
    let printed = false;
    function feed() {
      const r = sec.getBoundingClientRect();
      const total = r.height - window.innerHeight;
      let p = (-r.top) / (total || 1);
      p = Math.min(Math.max(p, 0), 1);
      // stepped mechanical increments
      const stepped = Math.round(p * 14) / 14;
      receipt.style.transform =
        'translateY(' + (-100 + stepped * 100).toFixed(2) + '%) rotate(' + (-1.2 + stepped * 0.9).toFixed(2) + 'deg)';
      if (stepped > 0.92 && !printed) {
        printed = true;
        barcode && barcode.classList.add('opacity-100');
      }
    }
    window.addEventListener('scroll', () => requestAnimationFrame(feed), { passive: true });
    window.addEventListener('resize', feed);
    feed();
  })();
</script>